{
  "name": "wb-review-bot",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "WB Review Bot — Cloudflare Workers runtime, Basic token now, Personal later",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "verify": "npm run typecheck && npm run lint && npm test",
    "check:env": "tsx scripts/check-env.ts",
    "smoke:staging": "tsx scripts/smoke-staging.ts",
    "db:migrate:local": "wrangler d1 migrations apply wb-review-bot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wb-review-bot-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
