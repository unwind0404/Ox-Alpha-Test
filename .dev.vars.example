# Пример .dev.vars для локальной разработки.
# Скопируйте в .dev.vars и подставьте свои значения.

# === Runtime ===
DEPLOYMENT_MODE="cloud"
ENVIRONMENT="dev"

# === WB API ===
WB_API_BASE="https://feedbacks-api.wildberries.ru"
WB_TOKEN_TYPE="basic"
# Сам токен НЕ хранится в .dev.vars — он в БД (D1), зашифрован.

# === OpenRouter ===
OPENROUTER_API_KEY="sk-or-v1-REPLACE_ME"

# === Безопасность (для dev — любые непустые) ===
ADMIN_PASSWORD="dev-password"
SESSION_SECRET="dev-session-secret-min-32-chars-long-string"
CRON_SECRET="dev-cron-secret"
MASTER_KEY="dev-master-key-32-bytes-base64==="
FINGERPRINT_KEY="dev-fingerprint-key-32-bytes-base64==="

# === Service Token для /api/admin/* (workers.dev НЕ поддерживает Cloudflare Access на Free плане) ===
# Генерируются случайно. Сейчас установлены в Worker'е через wrangler secret put.
# Для self-hosted auth на workers.dev используется Cf-Access-Client-Id + Cf-Access-Client-Secret.
ACCESS_CLIENT_ID="admin-XXXX"
ACCESS_CLIENT_SECRET="sec-XXXX"

# === Cron ===
MAX_ANSWERS_PER_RUN="20"

# === D1 (для wrangler dev) ===
# DATABASE_URL="file:./dev.db"  # wrangler создаст локально
